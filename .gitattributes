# Normalise text; keep Windows line endings for Windows scripts.
* text=auto
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.c    text eol=crlf
*.cpp  text eol=crlf
*.h    text eol=crlf
*.xml  text eol=crlf
*.rvmat text eol=crlf
*.cfg  text eol=crlf
*.sh   text eol=lf
.githooks/* text eol=lf

# Binary game assets -> Git LFS
*.p3d   filter=lfs diff=lfs merge=lfs -text
*.paa   filter=lfs diff=lfs merge=lfs -text
*.edds  filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.rtm   filter=lfs diff=lfs merge=lfs -text
*.anm   filter=lfs diff=lfs merge=lfs -text
*.wrp   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.asc   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
